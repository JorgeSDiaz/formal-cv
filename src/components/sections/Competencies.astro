---
import Section from "@/components/Section.astro";
import { ui } from "@/i18n/ui";

const { competencies, lang = "es" } = Astro.props;
const t = ui[lang as keyof typeof ui];
---

<Section title={t["section.competencies"]}>
  <div class="competencies-list">
    {
      competencies.map((comp) => (
        <div class="competency-category">
          <span class="category-name">{comp.name}: </span>
          <span class="category-keywords">{comp.keywords.join(", ")}.</span>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .competencies-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .competency-category {
    font-size: 0.85rem;
    color: #333;
  }

  .category-name {
    font-weight: bold;
  }

  .category-keywords {
    color: #555;
  }
</style>
