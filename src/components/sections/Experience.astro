---
import Section from "@/components/Section.astro";

import { ui } from "@/i18n/ui";

const { experience, lang = "es" } = Astro.props;
const t = ui[lang as keyof typeof ui];
---

<Section title={t["section.experience"]}>
  <div class="experience-list">
    {
      experience.map((job) => {
        const { name, position, summary, startDate, endDate, highlights, url } =
          job;

        return (
          <article class="experience-item">
            <header>
              <div class="title-row">
                <h3>
                  {url ? (
                    <a href={url} target="_blank">
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                </h3>
                <time>
                  {startDate} - {endDate}
                </time>
              </div>
              <h4>{position}</h4>
            </header>

            <ul class="responsibilities">
              {summary.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .experience-item {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    letter-spacing: 0.2px;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  h3 a:hover {
    color: #000;
    text-decoration: underline;
  }

  h4 {
    font-size: 0.9rem;
    font-weight: 500;
    color: #444;
    margin: 0;
    font-style: italic;
  }

  time {
    font-size: 0.85rem;
    color: #555;
    font-weight: 600;
    white-space: nowrap;
  }

  .responsibilities {
    list-style-type: disc;
    margin: 0.1rem 0 0.1rem 1rem;
    padding: 0;
    font-size: 0.85rem;
    color: #555;
  }

  .responsibilities li {
    margin-bottom: 0.05rem;
  }
</style>
